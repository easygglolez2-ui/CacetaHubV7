-- ===== Cores de piscada =====
local colors = {
    Color3.new(1, 0, 0),
    Color3.new(0, 1, 0),
    Color3.new(0, 0, 1),
    Color3.new(1, 0, 1),
    Color3.new(0, 1, 1),
